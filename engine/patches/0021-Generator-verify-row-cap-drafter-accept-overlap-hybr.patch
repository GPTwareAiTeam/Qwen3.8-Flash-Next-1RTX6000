+    def _spec_draft_launch(self, batch_jobs, draft_tokens, prestaged, W, p_export_states, block_index, p_cache_seqlens):
+        """
+        EXL3_SD_DRAFT_OVERLAP: with every row's staged window on the host, predict each job's accepted length (leading
+        draft matches, plus one) and next anchor (its last accepted sample), write the drafter K/V for those lengths and
+        queue the next round's drafter block, all before the host accept loop. Returns the predicted lengths (the
+        caller skips its own drafter update when the loop agrees) or None when the round doesn't qualify
+        """
+        if not (self.dflash_draft and self.draft_recurrent) or draft_tokens is None or W < 2:
+            return None
+        if not all(isinstance(a, SlidingAttention) for a in self.draft_model.attn_modules):
+            return None
+        if len(prestaged) != len(batch_jobs) or any(len(job.sequences) != 1 for job in batch_jobs):
+            return None
+        # A job about to start or still ingesting undoes the block next round anyway
+        if self.pending_jobs or len(batch_jobs) != len(self.active_jobs):
+            return None
+        # The speculative block must not shift a window ring (that moves stored rows, which a rollback can't undo):
+        # rows whose block would pass the ring end leave the round to the regular path
+        S = self.draft_model.attn_modules[0].kv_state_size
+        block = self.draft_model.config.block_size
+        lengths, anchors = [], []
+        for j, job in enumerate(batch_jobs):
+            staged = prestaged[j][0]
+            a = 1
+            while a < W and staged[a - 1][0].item() == draft_tokens[j, a - 1].item():
+                a += 1
+            lengths.append(a)
+            anchors.append(staged[a - 1][0].clone())
+            ds = job.recurrent_state.draft
+            if job.sequences[0].kv_position + a + block - ds.window_beg > S:
+                return None
+        states = [job.recurrent_state.draft for job in batch_jobs]
+        for ds in states:
+            ds.rewind(0)
+        self.draft_model.update_kv_from_target(
+            target_hidden = p_export_states,
+            cache = self.draft_cache,
+            lengths = lengths,
+            params = {"block_table": block_index, "cache_seqlens": p_cache_seqlens, "recurrent_states": states},
+        )
+        kv_next = [job.sequences[0].kv_position + n for job, n in zip(batch_jobs, lengths)]
+        saved = [ds.position for ds in states]
+        pending = self._dflash_draft_launch(batch_jobs, kv_next, torch.cat(anchors, dim = 0))
+        self._spec_draft = {
+            "jobs": list(batch_jobs), "states": states, "saved": saved, "kv": kv_next,
+            "anchors": [int(t.item()) for t in anchors], "pending": pending, "lengths": lengths,
+        }
+        return lengths
+
+
+    def _spec_draft_valid(self, spec, jobs) -> bool:
+        if len(jobs) != len(spec["jobs"]) or any(a is not b for a, b in zip(jobs, spec["jobs"])):
+            return False
+        for job, ds, kv, anchor in zip(jobs, spec["states"], spec["kv"], spec["anchors"]):
+            seq = job.sequences[0]
+            if job.recurrent_state is None or job.recurrent_state.draft is not ds or seq.kv_position != kv:
+                return False
+            if len(seq.sequence_ids) != kv + 1 or seq.sequence_ids.torch_slice(kv, kv + 1).item() != anchor:
+                return False
+        return True
+
+
+    def _spec_draft_rollback(self, spec):
+        """Undo the speculative drafter block: the drafter's window rings return to the positions they had after the
+        K/V update (the appended block rows are past them and are overwritten later); the launch's staging buffers are
+        released by draining the stream first"""
+        torch.cuda.synchronize(self.draft_model.input_layer.device)
+        for job, ds, pos in zip(spec["jobs"], spec["states"], spec["saved"]):
+            if job.recurrent_state is not None and job.recurrent_state.draft is ds and job in self.active_jobs:
+                ds.position = pos
+                ds.last_history = 0
+
+
 
