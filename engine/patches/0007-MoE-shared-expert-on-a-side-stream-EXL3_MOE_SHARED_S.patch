+// Partials of one matrix (m rows x n columns x its k splits). Multi-matrix launches lay the slots out at the largest
+// slot's size: exact when every slot has the launch's width (no width list), else a bound over all widths
+// n_j <= size_n: n_j * splits_for(n_j) <= min(n_j * ceil(TARGET / ncb_j), n_j * kgroups)
+// <= min(128 * (TARGET - 1) + size_n, size_n * kgroups)
+__host__ __device__ __forceinline__ int64_t slot_floats(int size_m, int size_k, int size_n, bool width_list)
+{
+    if (!width_list) return (int64_t) size_m * size_n * splits_for(size_m, size_k, size_n);
+    const int64_t a = 128 * (EXL3_DGEMV_TARGET_BLOCKS - 1) + size_n;
+    const int64_t b = (int64_t) size_n * (size_k / 128);
+    return (int64_t) size_m * (a < b ? a : b);
+}
