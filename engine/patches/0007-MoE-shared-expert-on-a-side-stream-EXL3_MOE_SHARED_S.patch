+@torch.inference_mode()
+def test_one_workspace_per_device(device):
+    """One workspace per device (EXL3_DGEMV_WS_MB, default 4 MiB of partials), shared by every stream: calls on a
+    second stream and inside a graph capture (its own capture stream) allocate nothing more and give the same bits;
+    a call whose partials exceed the workspace takes the vendor path"""
+    k, n, K, m = 2560, 640, 7, 8
+    p, suh, svh, g = _weights(k, n, K, 4242)
+    tr = torch.from_numpy(p.copy()).to(device)
+    sd, vd = suh.to(device), svh.to(device)
+    A = (torch.randn(m, k, generator = g) * 0.5).half().to(device)
+
+    def nontorch():
+        torch.cuda.synchronize(device)
+        free, total = torch.cuda.mem_get_info(device)
+        return total - free - torch.cuda.memory_reserved(device)
+
+    ref = _gemm(A, tr, sd, vd, n, False, 2)
+    base = nontorch()
+    C = torch.empty(m, n, dtype = torch.half, device = device)
+    Ah = torch.empty_like(A)
+    ext.exl3_dgemv_set_enabled(2)
+    try:
+        s = torch.cuda.Stream(device)
+        s.wait_stream(torch.cuda.current_stream(device))
+        with torch.cuda.stream(s):
+            ext.exl3_gemm(A, tr, C, sd, Ah, vd, -1, False, True, 0)
+            torch.cuda.synchronize(device)
+            assert torch.equal(C, ref)
+            gr = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(gr, stream = s):
+                ext.exl3_gemm(A, tr, C, sd, Ah, vd, -1, False, True, 0)
+        C.zero_()
+        gr.replay()
+        torch.cuda.synchronize(device)
+        assert torch.equal(C, ref)
+    finally:
+        ext.exl3_dgemv_set_enabled(-1)
+    # Not asserted: the non-torch delta (total - free - torch reserved) is torch's graph pool, reserved and freed across
+    # captures, not the DGEMV workspace. RM's 7b split: 0 MiB at the eager, second-stream, capture and control stages;
+    # +192 MiB only after the controls. The workspace is allocated at the first eager call, before `base`, and the bit
+    # checks above show the second stream and the capture use the same result.
+
+    # 48 rows x 2560 -> 12288: 3 k splits, 48 * 12288 * 3 fp32 partials = 6.75 MiB > the 4 MiB default
