+void BC_BlockSparseMLP::run_shared_pieces(const at::Tensor& y, int num_tokens)
+{
+    // The shared expert's multi-row graph covers MAX_BSZN rows: wider verify windows run it in pieces
+    for (int start = 0; start < num_tokens; start += MAX_BSZN)
+    {
+        const int end = std::min(start + MAX_BSZN, num_tokens);
+        at::Tensor x_dense = y.slice(0, start, end).unsqueeze(0);
+        at::Tensor out_piece = out_d_sh.value().slice(1, start, end);
+        shared_experts->run_bszN(x_dense, out_piece);
+    }
+}
+
+// -1: the env (EXL3_MOE_SHARED_SIDE, default off); exl3_moe_shared_side_set(0 / 1) overrides it (tests, benches)
+static int sh_side_override = -1;
+
+void exl3_moe_shared_side_set(int mode) { sh_side_override = mode; }
+
+bool BC_BlockSparseMLP::sh_side_enabled()
+{
+    if (sh_side_override >= 0) return sh_side_override != 0;
+    static const bool on = std::getenv("EXL3_MOE_SHARED_SIDE") && atoi(std::getenv("EXL3_MOE_SHARED_SIDE")) != 0;
+    return on;
+}
+
+cudaStream_t BC_BlockSparseMLP::sh_side_stream(int device)
+{
+    // One side stream per device for every MoE layer (their shared experts share scratch: layer order on one stream),
+    // at the greatest priority so its few blocks are scheduled ahead of the routed launch's remaining waves
+    static std::mutex mtx;
+    static std::map<int, cudaStream_t> streams;
+    std::lock_guard<std::mutex> lock(mtx);
+    auto it = streams.find(device);
+    if (it != streams.end()) return it->second;
+    int lo, hi;
+    AT_CUDA_CHECK(cudaDeviceGetStreamPriorityRange(&lo, &hi));
+    cudaStream_t s;
+    AT_CUDA_CHECK(cudaStreamCreateWithPriority(&s, cudaStreamNonBlocking, hi));
+    streams[device] = s;
+    return s;
+}
