+#ifndef EXL3_MOE_HALF_REG
+#define EXL3_MOE_HALF_REG 0
+#endif
+template <int bits, bool HALF>
+constexpr bool tile_reg_k() { return HALF ? (EXL3_MOE_HALF_REG != 0) : tile_reg<bits>(); }
