From: GPTware AI Team <dcmaxhome@users.noreply.github.com>
Date: Sun, 15 Nov 2026 21:41:27 -0500
Subject: [PATCH 13/21] Growable KV pool: release mapped pages from the top
 when the queue drains (EXL3_KV_GROW_DRAIN_FREE_MIB, default 6144), never
 below the highest referenced page or the premapped region
 (EXL3_KV_GROW_PREMAP_TOKENS, default 262144); limiter releases torch's cached
 blocks only when free memory is short

---
 exllamav3/cache/cache.py             |  8 ++++++
 exllamav3/cache/grow.py              | 16 +++++++++++
 exllamav3/cache/vmm.py               |  9 ++++++
 exllamav3/generator/generator.py     |  3 ++
 exllamav3/generator/pagetable.py     | 43 +++++++++++++++++++++++++++-
 exllamav3/generator/prefill_limit.py | 14 ++++++---
 6 files changed, 88 insertions(+), 5 deletions(-)

diff --git a/exllamav3/cache/cache.py b/exllamav3/cache/cache.py
index e03a1049..dbf9df3c 100644
--- a/exllamav3/cache/cache.py
+++ b/exllamav3/cache/cache.py
@@ -348,6 +348,14 @@ class Cache:
         return sum(l.ensure_pages(n) for l in self.layers.values() if getattr(l, "growable", lambda: False)())
 
 
+    def trim_pages(self, n: int) -> int:
+        """Release physical memory above page n in every growable layer (no kernel in flight may read it); returns
+        VRAM bytes released"""
+        from .grow import set_target
+        set_target(id(self), n)
+        return sum(l.trim_pages(n) for l in self.layers.values() if getattr(l, "growable", lambda: False)())
+
+
     def unmapped_bytes(self) -> int:
         """VRAM the growable layers have reserved address space for but not mapped (0 when none grows)"""
         return sum(l.reserved_bytes() - l.mapped_bytes() for l in self.layers.values()
diff --git a/exllamav3/cache/grow.py b/exllamav3/cache/grow.py
index 2a338a66..275ef3ea 100644
--- a/exllamav3/cache/grow.py
+++ b/exllamav3/cache/grow.py
@@ -21,6 +21,10 @@ _targets: dict[int, int] = {}
 def raise_target(cache_id: int, n: int):
     _targets[cache_id] = max(_targets.get(cache_id, 0), n)
 
+
+def set_target(cache_id: int, n: int):
+    _targets[cache_id] = n
+
 class GrowablePool:
     """Mixin for cache layers: alloc_pool(name, shape, dtype) creates a page-major pool tensor, growable when
     EXL3_KV_GROW=1 (else torch.zeros). ensure_pages(n) backs pages [0, n) of every growable tensor"""
@@ -82,6 +86,18 @@ class GrowablePool:
         self.backed_pages = n
         return got
 
+    def trim_pages(self, n: int) -> int:
+        """Release physical memory above page n (granule-rounded per tensor); the caller guarantees no kernel in
+        flight reads pages >= n. Returns the VRAM bytes released"""
+        if not self.growable() or n >= self.backed_pages:
+            return 0
+        got = 0
+        for name, r in self.ranges.items():
+            t = getattr(self, name)
+            got += r.trim(n * t.stride(0) * t.element_size())
+        self.backed_pages = n
+        return got
+
     def mapped_bytes(self) -> int:
         return sum(r.mapped for r in self.ranges.values()) if self.growable() else 0
 
diff --git a/exllamav3/cache/vmm.py b/exllamav3/cache/vmm.py
index 7a423a10..a9ad0d30 100644
--- a/exllamav3/cache/vmm.py
+++ b/exllamav3/cache/vmm.py
@@ -61,6 +61,15 @@ class VmmRange:
             ext().vmm_view(self.handle, self.mapped)[before:].zero_()
         return self.mapped - before
 
+    def trim(self, nbytes: int) -> int:
+        """Release physical memory above nbytes (rounded up to a granule, never below the first granule); returns
+        the bytes released. The caller guarantees no queued or running kernel reads the released tail."""
+        before = self.mapped
+        nbytes = max(int(nbytes), self.floor)
+        if nbytes < self.mapped:
+            self.mapped = ext().vmm_shrink(self.handle, nbytes)
+        return before - self.mapped
+
     def round_up(self, nbytes: int) -> int:
         g = self.granule
         return (nbytes + g - 1) // g * g
