 KV_GROW_LOG = os.environ.get("EXL3_KV_GROW_LOG", "0") == "1"
+KV_GROW_FLOOR = int(os.environ.get("EXL3_KV_GROW_PREMAP_TOKENS", "262144")) // PAGE_SIZE
+KV_GROW_DRAIN_FREE = int(os.environ.get("EXL3_KV_GROW_DRAIN_FREE_MIB", "6144")) << 20
 
 
 def _tensor_blake2b_checksum(tensor: torch.Tensor, prev_hash: bytes | None) -> bytes:
@@ -563,6 +568,42 @@ class PageTable:
                   flush = True)
 
 
+    def premap(self):
+        """Growable pool: map the fixed starting region (EXL3_KV_GROW_PREMAP_TOKENS) once, at start"""
+        if self.growable and self.cache.backed_pages() < min(KV_GROW_FLOOR, self.max_pages):
+            self.cache.ensure_pages(min(KV_GROW_FLOOR, self.max_pages))
+
+    def shrink(self) -> int:
+        """Growable pool, queue drained: release backed pages from the top down until the device has
+        EXL3_KV_GROW_DRAIN_FREE_MIB free, never below the highest referenced page or the premapped region. Cached
+        prompt pages below the cut are kept, those above are evicted (the caller then prunes stranded recurrent
+        checkpoints). Only with nothing in flight; returns the pages released"""
+        if not self.growable:
+            return 0
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+        free, _ = torch.cuda.mem_get_info()
+        need = KV_GROW_DRAIN_FREE - free
+        backed = self.cache.backed_pages()
+        if need <= 0:
+            return 0
+        pb = max(1, self.cache.page_bytes())
+        top = max((p.page_index for p in self.referenced_pages.values()), default = -1) + 1
+        keep = max(top, min(KV_GROW_FLOOR, self.max_pages), backed - (need + pb - 1) // pb)
+        if keep >= backed:
+            return 0
+        t0 = time.perf_counter()
+        for p in self.all_pages[keep:backed]:
+            if p.ref_count == 0 and p.kv_position:
+                self.evict(p)
+                p.clear()
+        self.cache.trim_pages(keep)
+        self.metrics["trim_pages"] = self.metrics.get("trim_pages", 0) + backed - keep
+        if KV_GROW_LOG:
+            print(f"KV_GROW shrink pages {backed}->{keep} free_MiB={free / 2**20:.0f}->"
+                  f"{torch.cuda.mem_get_info()[0] / 2**20:.0f} ms={(time.perf_counter() - t0) * 1e3:.1f}", flush = True)
+        return backed - keep
+
     def evict(self, page: CachePage, protect: set | None = None):
         """
         An unreferenced page is about to be repurposed and its current identity destroyed. At this point
