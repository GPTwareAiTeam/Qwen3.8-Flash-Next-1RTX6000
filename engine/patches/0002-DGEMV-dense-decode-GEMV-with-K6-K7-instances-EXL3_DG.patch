+            _ptrs(sv, device), torch.arange(3, dtype = torch.long, device = device).unsqueeze(0), None, K, -1, False, True,
+            -1, -1, 0, 1, torch.tensor(ns, dtype = torch.int32, device = device), _ptrs(outs, device))
+        for i, n in enumerate(ns):
