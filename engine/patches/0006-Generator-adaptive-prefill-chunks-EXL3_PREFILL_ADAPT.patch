 from .sampler import Sampler
@@ -270,6 +271,12 @@ class Generator:
         self.max_batch_size = max_batch_size
         self.max_chunk_size = max_chunk_size
 
+        # Adaptive prefill chunks (prefill_limit.py): shrink a planned chunk to what device memory allows.
+        # Single-device runs only; multi-device and TP runs keep fixed chunks
+        self.prefill_chunk_limit = None
+        if PREFILL_ADAPTIVE and torch.cuda.is_available() and len(self.model.active_devices) == 1:
+            self.prefill_chunk_limit = PrefillChunkLimiter(torch.device(self.model.active_devices[0]))
+
         # Prompt ingestion alongside generating jobs, see iterate()
         if shared_chunk_size is None:
             shared_chunk_size = (max_chunk_size // 2 + PAGE_SIZE - 1) // PAGE_SIZE * PAGE_SIZE
diff --git a/exllamav3/generator/job.py b/exllamav3/generator/job.py
