             if chunk_size is not None:
                 prefill_end = min(prefill_end, (prefill_start + chunk_size) // PAGE_SIZE * PAGE_SIZE)
 
+            # Adaptive limit (memory headroom): only ever shortens a chunk, to whole pages from prefill_start
