+// Fast run table (EXL3_MOE_COOP_FAST_RUNS, p.fast_runs): the same table as build_runs (slots ordered by (local expert,
+// slot), runs of at most ROWS slots of one expert, in that order) by a counting sort: per-expert counts, two block
+// scans (first position of each expert, first run of each expert) and a stable in-order rank of every slot within its
+// expert from one warp walking the slots 32 at a time (__match_any_sync). O(slots + experts) instead of build_runs'
+// O(slots x slots / threads), which dominates the rotation launch at verify widths (640 slots). Identical output.
+constexpr int FAST_RUNS_MAX_EXPERTS = 1024;
+
+__device__ __forceinline__ int block_excl_scan(int v, int* sh_warp, int* sh_total)
+{
+    const int lane = threadIdx.x % 32;
+    const int warp = threadIdx.x / 32;
+    int x = v;
+    #pragma unroll
+    for (int o = 1; o < 32; o <<= 1)
+    {
+        const int n = __shfl_up_sync(0xffffffffu, x, o);
+        if (lane >= o) x += n;
+    }
+    if (lane == 31) sh_warp[warp] = x;
+    __syncthreads();
+    if (threadIdx.x == 0)
+    {
+        int acc = 0;
+        for (int w = 0; w < WK; ++w) { const int t = sh_warp[w]; sh_warp[w] = acc; acc += t; }
+        *sh_total = acc;
+    }
+    __syncthreads();
+    const int r = sh_warp[warp] + x - v;
+    __syncthreads();
+    return r;
+}
+
+// sh_local [MAX_SLOTS] int16, sh_start / sh_fill / sh_roff [FAST_RUNS_MAX_EXPERTS] int, sh_scan [WK], sh_res [4]
+__device__ __forceinline__ void build_runs_fast
+(
+    const MoeCoopParams& p, int16_t* sh_local, int* sh_start, int* sh_fill, int* sh_roff, int* sh_scan, int* sh_res
+)
+{
+    const int slots = p.bsz * p.topk;
+    const int t = threadIdx.x;
+    const int lane = t % 32;
+    const int ne = p.n_local;
+    int* run_start = p.runs + 2;
+    int* order = p.runs + 2 + p.slots_max + 1;
+
+    for (int e = t; e < ne; e += THREADS) sh_fill[e] = 0;
+    __syncthreads();
+    for (int s = t; s < slots; s += THREADS)
+    {
+        const SlotInfo si = slot_info(p, s);
+        sh_local[s] = si.active ? (int16_t) si.local : (int16_t) -1;
+        if (si.active) atomicAdd(&sh_fill[si.local], 1);
+    }
+    __syncthreads();
+
+    // First position (sh_start) and first run (sh_roff) of every expert, experts in index order
+    int pos_base = 0, run_base = 0;
+    for (int e0 = 0; e0 < ne; e0 += THREADS)
+    {
+        const int e = e0 + t;
+        const int c = e < ne ? sh_fill[e] : 0;
+        const int po = block_excl_scan(c, sh_scan, sh_res + 2);
+        const int pt = sh_res[2];
+        const int ro = block_excl_scan((c + ROWS - 1) / ROWS, sh_scan, sh_res + 3);
+        const int rt = sh_res[3];
+        if (e < ne) { sh_start[e] = pos_base + po; sh_roff[e] = run_base + ro; sh_fill[e] = 0; }
+        pos_base += pt;
+        run_base += rt;
+        __syncthreads();
+    }
+
+    // Stable rank of every slot within its expert: one warp walks the slots in order, 32 at a time; peers of one
+    // expert in a 32-slot group take consecutive ranks in lane order, then the group leader advances the fill count
+    if (t < 32)
+    {
+        for (int s0 = 0; s0 < slots; s0 += 32)
+        {
+            const int s = s0 + lane;
+            const int e = s < slots ? (int) sh_local[s] : -1;
+            const unsigned peers = __match_any_sync(0xffffffffu, e);
+            int fill = 0;
+            if (e >= 0) fill = sh_fill[e];
+            __syncwarp();
+            if (e >= 0)
+            {
+                const int r = fill + __popc(peers & ((1u << lane) - 1u));
+                const int pos = sh_start[e] + r;
+                order[pos] = s;
+                if (r % ROWS == 0) run_start[sh_roff[e] + r / ROWS] = pos;
+                if (lane == __ffs(peers) - 1) sh_fill[e] = fill + __popc(peers);
+            }
+            __syncwarp();
+        }
+    }
+    if (t == 0)
+    {
+        run_start[run_base] = pos_base;
+        p.runs[0] = run_base;
+    }
+}
