diff --git a/exllamav3/cache/grow.py b/exllamav3/cache/grow.py
new file mode 100644
index 00000000..f2c24816
--- /dev/null
+++ b/exllamav3/cache/grow.py
@@ -0,0 +1,78 @@
+"""Growable KV pool (EXL3_KV_GROW=1, default off).
+
+Every page-major pool tensor ([num_pages, ...]) of a cache layer is a view of a VmmRange: the full pool is reserved
+as virtual address space at load, physical memory is mapped only for the page prefix the page table has handed out,
+in 2 MiB granules. Base addresses never move, so captured CUDA graphs stay valid. With the pool mostly empty the
+unmapped part is free VRAM, which the adaptive prefill limiter can spend on larger chunks.
+"""
+from __future__ import annotations
+
+import os
+
+import torch
+
+KV_GROW = os.environ.get("EXL3_KV_GROW", "0") == "1"
+
+
+class GrowablePool:
+    """Mixin for cache layers: alloc_pool(name, shape, dtype) creates a page-major pool tensor, growable when
+    EXL3_KV_GROW=1 (else torch.zeros). ensure_pages(n) backs pages [0, n) of every growable tensor"""
+
+    def _grow_init(self):
+        if not hasattr(self, "ranges"):
+            self.ranges = None
+            self.backed_pages = None
+
+    def alloc_pool(self, device, name: str, shape: tuple, dtype: torch.dtype):
+        self._grow_init()
+        if not KV_GROW:
+            t = torch.zeros(shape, dtype = dtype, device = device)
+            setattr(self, name, t)
+            return t
+        from .vmm import VmmRange
+        if self.ranges is None:
+            self.ranges = {}
+            self.backed_pages = 0
+            self.num_pages = shape[0]
+        assert shape[0] == self.num_pages
+        n = 1
+        for s in shape:
+            n *= s
+        r = VmmRange(device, n * torch.empty((), dtype = dtype).element_size())
+        self.ranges[name] = r
+        t = r.view(dtype, shape)
+        setattr(self, name, t)
+        return t
+
+    def free_pools(self):
+        for r in (getattr(self, "ranges", None) or {}).values():
+            r.free()
+        self.ranges = None
+        self.backed_pages = None
+
+    def growable(self) -> bool:
+        return bool(getattr(self, "ranges", None))
+
+    def page_bytes(self) -> int:
+        """VRAM one more backed page costs across this layer's growable tensors"""
+        if not self.growable():
+            return 0
+        return sum(getattr(self, name)[0].numel() * getattr(self, name).element_size() for name in self.ranges)
+
+    def ensure_pages(self, n: int) -> int:
+        """Back pages [0, n) of every growable tensor (zero-filled); returns the VRAM bytes newly mapped"""
+        if not self.growable() or n <= self.backed_pages:
+            return 0
+        n = min(n, self.num_pages)
+        got = 0
+        for name, r in self.ranges.items():
+            t = getattr(self, name)
+            got += r.ensure(n * t.stride(0) * t.element_size())
+        self.backed_pages = n
+        return got
+
+    def mapped_bytes(self) -> int:
+        return sum(r.mapped for r in self.ranges.values()) if self.growable() else 0
+
+    def reserved_bytes(self) -> int:
+        return sum(r.reserved for r in self.ranges.values()) if self.growable() else 0
diff --git a/exllamav3/cache/native/vmm_pool.cpp b/exllamav3/cache/native/vmm_pool.cpp
new file mode 100644
index 00000000..96c2bfb6
--- /dev/null
+++ b/exllamav3/cache/native/vmm_pool.cpp
@@ -0,0 +1,112 @@
+// Growable device pool on CUDA virtual memory management (driver API): reserve a virtual range for the maximum size
+// once, map physical chunks into it on demand (grow) and unmap them again (shrink). The base address never moves, so
+// kernels and captured CUDA graphs that bake it stay valid. Exposed to torch as a tensor view of the full range;
+// only [0, mapped) may be touched.
+#include <torch/extension.h>
+#include <cuda.h>
+#include <vector>
+
+namespace {
+
+#define CU(x) do { CUresult r_ = (x); if (r_ != CUDA_SUCCESS) { const char* s_ = nullptr; cuGetErrorString(r_, &s_); \
+    TORCH_CHECK(false, #x " failed: ", s_ ? s_ : "?"); } } while (0)
+
+struct Pool {
+    int device;
+    CUdeviceptr base = 0;
+    size_t reserved = 0, granule = 0, mapped = 0;
+    std::vector<CUmemGenericAllocationHandle> chunks;     // one per granule, in address order
+};
+
+CUmemAllocationProp prop_for(int device)
+{
+    CUmemAllocationProp p = {};
+    p.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    p.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    p.location.id = device;
+    return p;
+}
+
+}  // namespace
+
+int64_t vmm_create(int64_t device, int64_t max_bytes)
+{
+    CU(cuInit(0));
+    auto* p = new Pool();
+    p->device = (int) device;
+    CUmemAllocationProp prop = prop_for(p->device);
+    CU(cuMemGetAllocationGranularity(&p->granule, &prop, CU_MEM_ALLOC_GRANULARITY_RECOMMENDED));
+    p->reserved = (max_bytes + p->granule - 1) / p->granule * p->granule;
+    CU(cuMemAddressReserve(&p->base, p->reserved, p->granule, 0, 0));
+    return (int64_t) p;
+}
+
+// Map physical memory so that at least `bytes` from the base are backed. Returns the mapped size.
+int64_t vmm_grow(int64_t h, int64_t bytes)
+{
+    auto* p = (Pool*) h;
+    TORCH_CHECK((size_t) bytes <= p->reserved, "vmm_grow: ", bytes, " > reserved ", p->reserved);
+    CUmemAllocationProp prop = prop_for(p->device);
+    CUmemAccessDesc acc = {};
+    acc.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    acc.location.id = p->device;
+    acc.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    while (p->mapped < (size_t) bytes)
+    {
+        CUmemGenericAllocationHandle c;
+        CU(cuMemCreate(&c, p->granule, &prop, 0));
+        CU(cuMemMap(p->base + p->mapped, p->granule, 0, c, 0));
+        CU(cuMemSetAccess(p->base + p->mapped, p->granule, &acc, 1));
+        p->chunks.push_back(c);
+        p->mapped += p->granule;
+    }
+    return (int64_t) p->mapped;
+}
+
+// Unmap and release physical memory down to `bytes` (rounded up to a granule). Caller guarantees nothing in flight
+// reads the released tail (synchronize first). Returns the mapped size.
+int64_t vmm_shrink(int64_t h, int64_t bytes)
+{
+    auto* p = (Pool*) h;
+    size_t keep = ((size_t) bytes + p->granule - 1) / p->granule * p->granule;
+    while (p->mapped > keep)
+    {
+        p->mapped -= p->granule;
+        CU(cuMemUnmap(p->base + p->mapped, p->granule));
+        CU(cuMemRelease(p->chunks.back()));
+        p->chunks.pop_back();
+    }
+    return (int64_t) p->mapped;
+}
+
+at::Tensor vmm_view(int64_t h, int64_t nbytes)
+{
+    auto* p = (Pool*) h;
+    TORCH_CHECK((size_t) nbytes <= p->reserved);
+    return torch::from_blob((void*) p->base, {nbytes}, [](void*) {},
+                            torch::TensorOptions().dtype(torch::kUInt8).device(torch::kCUDA, p->device));
+}
+
+std::vector<int64_t> vmm_info(int64_t h)
+{
+    auto* p = (Pool*) h;
+    return { (int64_t) p->base, (int64_t) p->reserved, (int64_t) p->mapped, (int64_t) p->granule };
+}
+
+void vmm_destroy(int64_t h)
+{
+    auto* p = (Pool*) h;
+    vmm_shrink(h, 0);
+    cuMemAddressFree(p->base, p->reserved);
+    delete p;
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m)
+{
+    m.def("vmm_create", &vmm_create);
+    m.def("vmm_grow", &vmm_grow);
+    m.def("vmm_shrink", &vmm_shrink);
+    m.def("vmm_view", &vmm_view);
+    m.def("vmm_info", &vmm_info);
+    m.def("vmm_destroy", &vmm_destroy);
+}
