     m.def("exl3_dgemv_set_enabled", &exl3_dgemv_set_enabled, "exl3_dgemv_set_enabled");
     m.def("exl3_moe_shared_side_set", &exl3_moe_shared_side_set, "exl3_moe_shared_side_set");
+    m.def("exl3_moe_shared_wide_set", &exl3_moe_shared_wide_set, "exl3_moe_shared_wide_set");
     m.def("exl3_dgemv_splits_for", &exl3_dgemv_splits_for, "exl3_dgemv_splits_for");
 #endif
     m.def("rope", &rope, "rope");
diff --git a/exllamav3/exllamav3_ext/libtorch/blocksparse_mlp.cpp b/exllamav3/exllamav3_ext/libtorch/blocksparse_mlp.cpp
index fba04e4c..cba732a7 100644
--- a/exllamav3/exllamav3_ext/libtorch/blocksparse_mlp.cpp
+++ b/exllamav3/exllamav3_ext/libtorch/blocksparse_mlp.cpp
@@ -144,6 +144,15 @@ void BC_BlockSparseMLP::run_bszN
 
 void BC_BlockSparseMLP::run_shared_pieces(const at::Tensor& y, int num_tokens)
 {
+    // EXL3_MOE_SHARED_WIDE=1: a verify window wider than MAX_BSZN runs the shared expert as one ungraphed pass over
+    // all rows (one gate/up and one down launch) instead of one graph replay per MAX_BSZN-row piece
+    if (num_tokens > MAX_BSZN && sh_wide_enabled())
+    {
+        at::Tensor x_dense = y.slice(0, 0, num_tokens).unsqueeze(0);
+        at::Tensor out_n = out_d_sh.value().slice(1, 0, num_tokens);
+        shared_experts->run_wide(x_dense, out_n);
+        return;
+    }
     // The shared expert's multi-row graph covers MAX_BSZN rows: wider verify windows run it in pieces
     for (int start = 0; start < num_tokens; start += MAX_BSZN)
     {
@@ -154,6 +163,18 @@ void BC_BlockSparseMLP::run_shared_pieces(const at::Tensor& y, int num_tokens)
     }
 }
 
+// -1: the env (EXL3_MOE_SHARED_WIDE, default off); exl3_moe_shared_wide_set(0 / 1) overrides it (tests, benches)
+static int sh_wide_override = -1;
+
+void exl3_moe_shared_wide_set(int mode) { sh_wide_override = mode; }
+
+bool BC_BlockSparseMLP::sh_wide_enabled()
+{
+    if (sh_wide_override >= 0) return sh_wide_override != 0;
+    static const bool on = std::getenv("EXL3_MOE_SHARED_WIDE") && atoi(std::getenv("EXL3_MOE_SHARED_WIDE")) != 0;
+    return on;
+}
+
 // -1: the env (EXL3_MOE_SHARED_SIDE, default off); exl3_moe_shared_side_set(0 / 1) overrides it (tests, benches)
 static int sh_side_override = -1;
 
