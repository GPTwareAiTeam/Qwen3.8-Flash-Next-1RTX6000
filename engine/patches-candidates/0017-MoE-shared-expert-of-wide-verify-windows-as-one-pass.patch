     cudaEvent_t sh_fork = nullptr, sh_join = nullptr;
     void run_shared_pieces(const at::Tensor& y, int num_tokens);
     static bool sh_side_enabled();
+    static bool sh_wide_enabled();
     static cudaStream_t sh_side_stream(int device);
 
 #if defined(USE_ROCM)
diff --git a/exllamav3/exllamav3_ext/libtorch/mlp.cpp b/exllamav3/exllamav3_ext/libtorch/mlp.cpp
index 4e80c153..86e9a806 100644
--- a/exllamav3/exllamav3_ext/libtorch/mlp.cpp
+++ b/exllamav3/exllamav3_ext/libtorch/mlp.cpp
@@ -24,6 +24,12 @@ void BC_GatedMLP::run_bszN_gr
     // fused mgemm kernel's raw j*size_m*size_k slot addressing for any num_tokens != MAX_BSZN --
     // use exactly-shaped, lazily-cached buffers instead (a/down_xh have no such issue: their slot
     // dim is size 1, so slicing the token dim -- the true leading dim there -- stays contiguous)
+    // Widths past MAX_BSZN (run_wide) grow the caches and take lazily allocated, exactly-shaped activation scratch
+    if ((int) guh_cache.size() < num_tokens)
+    {
+        guh_cache.resize(num_tokens);
+        gu_cache.resize(num_tokens);
+    }
     at::Tensor& guh_n_ref = guh_cache[num_tokens - 1];
     if (!guh_n_ref.defined())
         guh_n_ref = at::empty({2, num_tokens, guh.size(2)}, guh.options());
@@ -32,8 +38,23 @@ void BC_GatedMLP::run_bszN_gr
         gu_n_ref = at::empty({2, num_tokens, gu.size(2)}, gu.options());
     at::Tensor guh_n     = guh_n_ref;
     at::Tensor gu_n      = gu_n_ref;
-    at::Tensor a_n       = a.slice(1, 0, num_tokens);
-    at::Tensor down_xh_n = down_xh.slice(1, 0, num_tokens);
+    at::Tensor a_n;
+    at::Tensor down_xh_n;
+    if (num_tokens <= a.size(1))
+    {
+        a_n       = a.slice(1, 0, num_tokens);
+        down_xh_n = down_xh.slice(1, 0, num_tokens);
+    }
+    else
+    {
+        if (!a_wide.defined() || a_wide.size(1) < num_tokens)
+        {
+            a_wide       = at::empty({1, num_tokens, a.size(2)}, a.options());
+            down_xh_wide = at::empty({1, num_tokens, down_xh.size(2)}, down_xh.options());
+        }
+        a_n       = a_wide.slice(1, 0, num_tokens);
+        down_xh_n = down_xh_wide.slice(1, 0, num_tokens);
+    }
 
     if (gu_ptrs_trellis)
     {
@@ -146,6 +167,20 @@ void BC_GatedMLP::run_bszN
     }
 }
 
+void BC_GatedMLP::run_wide
+(
+    const at::Tensor& x,
+    at::Tensor& d
+)
+{
+    // Any row count as one ungraphed pass: one gate/up launch, the activation and one down launch over all rows,
+    // instead of one MAX_BSZN-row graph replay per piece
+    int num_tokens = (int) x.numel() / (int) x.size(-1);
+    TORCH_CHECK(num_tokens >= 1, "run_wide: no rows");
+    c10::cuda::CUDAGuard device_guard(x.device());
+    run_bszN_gr(x, d, num_tokens, nullptr);
+}
+
 void BC_MLP::run_bsz1_gr
 (
     const at::Tensor& x,
