 exllamav3/exllamav3_ext/bindings.cpp          |  1 +
 .../libtorch/blocksparse_mlp.cpp              | 21 ++++++++++
 .../exllamav3_ext/libtorch/blocksparse_mlp.h  |  2 +
 exllamav3/exllamav3_ext/libtorch/mlp.cpp      | 39 ++++++++++++++++++-
 exllamav3/exllamav3_ext/libtorch/mlp.h        | 11 ++++++
 exllamav3/exllamav3_ext/libtorch/mlp_bc.h     |  3 +-
 6 files changed, 74 insertions(+), 3 deletions(-)

