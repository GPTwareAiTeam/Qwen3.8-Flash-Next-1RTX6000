@@ -2321,3 +2321,39 @@ void batched_scan_replay
         cuda_check(cudaPeekAtLastError());
     }
 }
+
+void batched_rewind_flat
+(
+    const at::Tensor& conv_desc,
+    const at::Tensor& replay_desc,
+    int device_index,
+    int kind,
+    int num_k_heads,
+    int num_v_heads,
+    int k_head_dim,
+    int v_head_dim,
+    bool state_half
+)
+{
+    TORCH_CHECK(conv_desc.device().is_cpu() && conv_desc.dtype() == at::kLong && conv_desc.dim() == 2 && conv_desc.size(1) == 5,
+                "batched_rewind_flat: conv_desc must be CPU int64 [n, 5]");
+    TORCH_CHECK(replay_desc.device().is_cpu() && replay_desc.dtype() == at::kLong && replay_desc.dim() == 2 && replay_desc.size(1) == 8,
+                "batched_rewind_flat: replay_desc must be CPU int64 [m, 8]");
+    at::Tensor cd = conv_desc.contiguous();
+    at::Tensor rd = replay_desc.contiguous();
+    const int64_t* c = cd.data_ptr<int64_t>();
+    const int64_t* r = rd.data_ptr<int64_t>();
+
+    std::vector<ConvRewindJob> conv_jobs;
+    conv_jobs.reserve(cd.size(0));
+    for (int64_t i = 0; i < cd.size(0); ++i, c += 5)
+        conv_jobs.emplace_back((uintptr_t) c[0], (uintptr_t) c[1], (int) c[2], (int) c[3], (int) c[4]);
+    batched_conv_rewind(conv_jobs, device_index);
+
+    std::vector<ScanReplayJob> replay_jobs;
+    replay_jobs.reserve(rd.size(0));
+    for (int64_t i = 0; i < rd.size(0); ++i, r += 8)
+        replay_jobs.emplace_back((uintptr_t) r[0], (uintptr_t) r[1], (uintptr_t) r[2], (uintptr_t) r[3], (uintptr_t) r[4],
+                                 (uintptr_t) r[5], (int) r[6], (int) r[7]);
+    batched_scan_replay(replay_jobs, device_index, kind, num_k_heads, num_v_heads, k_head_dim, v_head_dim, state_half);
+}
