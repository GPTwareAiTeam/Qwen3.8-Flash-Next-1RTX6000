+    @staticmethod
+    def rewind_many(pending: list):
+        """rewind() of several states at once: pending is a list of (state, num_tokens). The GDN
+        layer jobs of every state (one conv copy per layer, one scan replay per layer when tokens
+        were rejected) are built as two descriptor arrays and run through batched_rewind_flat, a
+        few launches for the whole batch instead of two per state plus ~10 us of Python per layer
+        and state. Same kernels on the same descriptors; states own disjoint pool rows, so the
+        grouping into launches changes no result. Tensor-parallel caches and states of other
+        types take the per-state path"""
+        import numpy as np
+        groups = {}
+        for state, n in pending:
+            if not isinstance(state, GDNState) or state.cache.model.loaded_tp or state.last_history == 0:
+                state.rewind(n)
+                continue
+            assert 0 <= n <= state.last_history, \
+                f"GDN rewind: {n} tokens outside the recorded history of {state.last_history}"
+            groups.setdefault(id(state.cache), (state.cache, []))[1].append((state, n))
+
+        for cache, items in groups.values():
+            layers = list(cache.get_all_recurrent_layers().values())
+            gdn = [l for l in layers if isinstance(l, GDNLayerState)]
+            other = [l for l in layers if not isinstance(l, GDNLayerState)]
+            for state, n in items:
+                for l in other:
+                    l.rewind(state.slot, state.last_history, n)
+
+            # Per-layer constants (byte addresses and strides); per-state offsets are added below
+            by_key = {}
+            for l in gdn:
+                key = (torch.device(l.device).index,) + l.scan_geometry()
+                by_key.setdefault(key, []).append(l)
+            for key, ls in by_key.items():
+                device_index = key[0]
+                cs0 = ls[0].conv_state
+                es = cs0.element_size()
+                cdim = ls[0].module.conv_kernel_size
+                assert all(l.conv_state.shape == cs0.shape and l.conv_state.stride() == cs0.stride()
+                           and l.module.conv_kernel_size == cdim for l in ls), "GDN rewind_many: mixed conv layouts"
+                conv_base = np.array([l.conv_state.data_ptr() for l in ls], dtype = np.int64)
+                cs_stride0 = cs0.stride(0) * es
+                cs_stride2 = cs0.stride(2) * es
+                cs_len = cs0.shape[-1]
+                rs0, sc0, sg0, sb0 = ls[0].recurrent_state, ls[0].spec_conv, ls[0].spec_g, ls[0].spec_beta
+                rs_base = np.array([l.recurrent_state.data_ptr() for l in ls], dtype = np.int64)
+                sc_base = np.array([l.spec_conv.data_ptr() for l in ls], dtype = np.int64)
+                sg_base = np.array([l.spec_g.data_ptr() for l in ls], dtype = np.int64)
+                sb_base = np.array([l.spec_beta.data_ptr() for l in ls], dtype = np.int64)
+                d_ptr = np.array([getattr(l.module, "d_skip_f", None).data_ptr()
+                                  if getattr(l.module, "d_skip_f", None) is not None else 0 for l in ls], dtype = np.int64)
+                row_bytes = rs0.stride(0) * rs0.element_size()
+                sc_row = sc0.stride(0) * sc0.element_size()
+                sg_row = sg0.stride(0) * sg0.element_size()
+                sb_row = sb0.stride(0) * sb0.element_size()
+
+                conv_rows, replay_rows = [], []
+                for state, n in items:
+                    slot_off = state.slot * cs_stride0
+                    p = cs_len - n
+                    c = np.empty((len(ls), 5), dtype = np.int64)
+                    c[:, 0] = conv_base + slot_off + (p - cdim) * cs_stride2
+                    c[:, 1] = conv_base + slot_off
+                    c[:, 2] = cs0.shape[1]
+                    c[:, 3] = cdim
+                    c[:, 4] = cs0.stride(1)
+                    conv_rows.append(c)
+                    if n > 0:
