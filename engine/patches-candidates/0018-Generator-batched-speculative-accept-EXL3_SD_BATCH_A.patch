+                        r[:, 0] = sc_base + r0 * sc_row
+                        r[:, 1] = sg_base + r0 * sg_row
+                        r[:, 2] = sb_base + r0 * sb_row
+                        r[:, 3] = rs_base + state.base_row() * row_bytes
+                        r[:, 4] = rs_base + state.scratch_row() * row_bytes
+                        r[:, 5] = d_ptr
+                        r[:, 6] = prefix
+                        r[:, 7] = tstride
+                        replay_rows.append(r)
+                conv_desc = torch.from_numpy(np.concatenate(conv_rows)) if conv_rows else torch.empty((0, 5), dtype = torch.long)
+                replay_desc = torch.from_numpy(np.concatenate(replay_rows)) if replay_rows else torch.empty((0, 8), dtype = torch.long)
+                kind, nk, nv, dk, dv, state_half = key[1:]
